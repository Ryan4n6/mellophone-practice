// The Worker behind mellophone.themassfellers.com (#1). Deploy from this
// directory with the Global API Key (a Custom Domain is a zone write the
// scoped token cannot make): env -u CLOUDFLARE_API_TOKEN npx wrangler deploy
{
  "name": "honk-it-up",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "mellophone.themassfellers.com", "custom_domain": true }],
  "analytics_engine_datasets": [{ "binding": "HITS", "dataset": "honk_it_up_hits" }],
  "observability": { "enabled": true }
}
