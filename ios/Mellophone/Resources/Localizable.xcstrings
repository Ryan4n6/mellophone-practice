    "Hold each note as long as you can, steady and in tune. It is boring, and it is the thing that makes a section sound good.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén cada nota todo lo que puedas, estable y afinada. Es aburrido, pero es lo que hace que una sección suene bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens chaque note aussi longtemps que possible, stable et juste. C'est ennuyeux, mais c'est ce qui fait bien sonner un pupitre."
          }
        }
      }
    },
