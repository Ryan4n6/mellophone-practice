    "%lld bars do not add up and are outlined in red. The rhythm there may be wrong, so trust the page over the app.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld bar does not add up and is outlined in red. The rhythm there may be wrong, so trust the page over the app."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld bars do not add up and are outlined in red. The rhythm there may be wrong, so trust the page over the app."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld compás no cuadra y está marcado en rojo. El ritmo ahí puede estar mal, así que confía más en la partitura que en la app."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld compases no cuadran y están marcados en rojo. El ritmo ahí puede estar mal, así que confía más en la partitura que en la app."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld mesure ne tombe pas juste et est entourée en rouge. Le rythme y est peut-être faux, alors fie-toi à la partition plutôt qu'à l'app."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld mesures ne tombent pas juste et sont entourées en rouge. Le rythme y est peut-être faux, alors fie-toi à la partition plutôt qu'à l'app."
                }
              }
            }
          }
        }
      }
    },
