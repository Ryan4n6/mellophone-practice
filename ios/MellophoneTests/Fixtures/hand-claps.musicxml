<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  The SOURCE of ios/MellophoneTests/Fixtures/hand-claps.pdf (#53), kept in
  the repo so the fixture can be regenerated instead of being an opaque
  binary nobody can check. RasterReaderTests draws it into a picture at
  450 ppi itself, the shape of an ePrint, so no picture of it is committed.

  This content is OURS, written for this test and nothing else. Eight bars
  of 4/4, a horn line either side of five bars of hand claps printed as x
  noteheads on the middle space, the way a band part prints them:

    bar 1   C5 G4 E4 (half), played
    bar 2   three quarter claps and a quarter rest
    bar 3   two beamed eighth claps, a quarter clap, a dotted quarter clap
            and a flagged eighth clap
    bar 4   an eighth and two sixteenth claps beamed, a half rest, a
            quarter clap
    bar 5   an eighth rest, an eighth clap, a quarter rest, two beamed
            eighth claps, a quarter rest, all stems UP
    bar 6   a flagged eighth clap, an eighth rest, a quarter clap, a half
            rest
    bar 7   G4 F4 E4 D4, played
    bar 8   C4, a whole note

  Regenerate with:
    "/Applications/MuseScore 4.app/Contents/MacOS/mscore" \
      -o ios/MellophoneTests/Fixtures/hand-claps.pdf \
      ios/MellophoneTests/Fixtures/hand-claps.musicxml
-->
