<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  The SOURCE of ios/MellophoneTests/Fixtures/bass-clef.pdf (#73), kept in the
  repo so the fixture can be regenerated instead of being an opaque binary
  nobody can check. The tests draw it into a picture at 450 ppi themselves,
  the shape of an ePrint, so no picture of it is committed.

  This content is OURS, written for this test and nothing else: a tuba part
  in bass clef at concert pitch, twelve bars of 4/4 at 96, built to trap a
  reader that only knows treble.

    bars 1 to 2   the tuba's open series Bb1 F2 Bb2 D3 F3 Bb3 D4 F4, ledger
                  lines over the staff (2 flats)
    bar 3         E1 with a natural (the key says Eb) and F1, four ledger
                  lines under the staff, the bottom of the tuba's span
    bar 4         Eb2 from the key alone, A2 C3 Bb2
    bar 5         a beamed eighth scale G2 to G3, Eb3 from the key
    bar 7         a key change to 3 sharps: A2 C#3 E3 A3
    bar 8         G#2 and F#2 from the key, G2 with a natural
    bar 9         A1 and E2
    bar 10        a key change to 4 flats: Ab1 Db2 Eb2 Ab2, all from the key
    bars 11 to 12 C3 Db3 Bb2 G2, then Ab2

  Every line after the first redraws its key signature in BASS positions
  (the flats start on the B2 line, the sharps on the F3 line), which a reader
  anchored on a treble clef reads as other letters.

  Regenerate with:
    "/Applications/MuseScore 4.app/Contents/MacOS/mscore" \
      -o ios/MellophoneTests/Fixtures/bass-clef.pdf \
      ios/MellophoneTests/Fixtures/bass-clef.musicxml
-->
<score-partwise version="4.0">
  <work>
    <work-title>Bass Clef Traps</work-title>
  </work>
  <part-list>
    <score-part id="P1">
      <part-name>Tuba</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <key><fifths>-2</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>F</sign><line>4</line></clef>
      </attributes>
      <direction placement="above"><direction-type><metronome><beat-unit>quarter</beat-unit><per-minute>96</per-minute></metronome></direction-type><sound tempo="96"/></direction>
      <note><pitch><step>B</step><alter>-1</alter><octave>1</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>F</step><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>B</step><alter>-1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>D</step><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
    </measure>
    <measure number="2">
      <note><pitch><step>F</step><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>B</step><alter>-1</alter><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>2</duration><type>quarter</type></note>
    </measure>
    <measure number="3">
      <note><pitch><step>E</step><octave>1</octave></pitch><duration>4</duration><type>half</type><accidental>natural</accidental></note>
      <note><pitch><step>F</step><octave>1</octave></pitch><duration>4</duration><type>half</type></note>
    </measure>
    <measure number="4">
      <note><pitch><step>E</step><alter>-1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>A</step><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>C</step><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>B</step><alter>-1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
    </measure>
    <measure number="5">
      <note><pitch><step>G</step><octave>2</octave></pitch><duration>1</duration><type>eighth</type></note>
      <note><pitch><step>A</step><octave>2</octave></pitch><duration>1</duration><type>eighth</type></note>
      <note><pitch><step>B</step><alter>-1</alter><octave>2</octave></pitch><duration>1</duration><type>eighth</type></note>
      <note><pitch><step>C</step><octave>3</octave></pitch><duration>1</duration><type>eighth</type></note>
      <note><pitch><step>D</step><octave>3</octave></pitch><duration>1</duration><type>eighth</type></note>
      <note><pitch><step>E</step><alter>-1</alter><octave>3</octave></pitch><duration>1</duration><type>eighth</type></note>
      <note><pitch><step>F</step><octave>3</octave></pitch><duration>1</duration><type>eighth</type></note>
      <note><pitch><step>G</step><octave>3</octave></pitch><duration>1</duration><type>eighth</type></note>
    </measure>
    <measure number="6">
      <note><pitch><step>B</step><alter>-1</alter><octave>2</octave></pitch><duration>8</duration><type>whole</type></note>
    </measure>
    <measure number="7">
      <attributes>
        <key><fifths>3</fifths></key>
      </attributes>
      <note><pitch><step>A</step><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>C</step><alter>1</alter><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>E</step><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>A</step><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
    </measure>
    <measure number="8">
      <note><pitch><step>G</step><alter>1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>F</step><alter>1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>G</step><octave>2</octave></pitch><duration>2</duration><type>quarter</type><accidental>natural</accidental></note>
      <note><pitch><step>A</step><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
    </measure>
    <measure number="9">
      <note><pitch><step>A</step><octave>1</octave></pitch><duration>4</duration><type>half</type></note>
      <note><pitch><step>E</step><octave>2</octave></pitch><duration>4</duration><type>half</type></note>
    </measure>
    <measure number="10">
      <attributes>
        <key><fifths>-4</fifths></key>
      </attributes>
      <note><pitch><step>A</step><alter>-1</alter><octave>1</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>D</step><alter>-1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>E</step><alter>-1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>A</step><alter>-1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
    </measure>
    <measure number="11">
      <note><pitch><step>C</step><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>D</step><alter>-1</alter><octave>3</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>B</step><alter>-1</alter><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
      <note><pitch><step>G</step><octave>2</octave></pitch><duration>2</duration><type>quarter</type></note>
    </measure>
    <measure number="12">
      <note><pitch><step>A</step><alter>-1</alter><octave>2</octave></pitch><duration>8</duration><type>whole</type></note>
    </measure>
  </part>
</score-partwise>
