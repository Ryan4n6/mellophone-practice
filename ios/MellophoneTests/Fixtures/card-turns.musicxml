<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  The SOURCE of ios/MellophoneTests/Fixtures/card-turns.pdf (#43), kept in the
  repo so the fixture can be regenerated instead of being an opaque binary.

  This content is OURS, written for this test and nothing else: 21 bars of
  plain quarters and halves in F major, a line every three bars, and a new
  page at bar 13, so it engraves as seven lines, four on page 1 and three on
  page 2. It is the only chart we own with more than one card and a card
  that crosses a page break. Sam's charts are copyrighted and stay in
  Fixtures/local/, gitignored.

  Regenerate with:
    "/Applications/MuseScore 4.app/Contents/MacOS/mscore" \
      -o ios/MellophoneTests/Fixtures/card-turns.pdf \
      ios/MellophoneTests/Fixtures/card-turns.musicxml
-->
